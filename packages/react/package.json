{
  "name": "@evicons/react",
  "version": "0.6.0",
  "description": "EVicons React icon components for e-mobility and EV charging",
  "keywords": [
    "icons",
    "svg",
    "react",
    "react-icons",
    "ev",
    "electric-vehicle",
    "ev-charging",
    "e-mobility",
    "charging",
    "charging-station",
    "evse",
    "type2",
    "ccs"
  ],
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "icons/*": ["./dist/icons/*.d.ts"]
    }
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./icons/*": { "types": "./dist/icons/*.d.ts", "import": "./dist/icons/*.js", "default": "./dist/icons/*.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "repository": { "type": "git", "url": "git+https://github.com/evicons/evicons.git", "directory": "packages/react" },
  "homepage": "https://github.com/evicons/evicons",
  "bugs": { "url": "https://github.com/evicons/evicons/issues" }
}
