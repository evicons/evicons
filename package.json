{
  "name": "evicons-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "lint:icons": "node tools/lint-icons.ts",
    "build:icons": "node tools/build-icons.ts",
    "build": "npm run build:icons && npm run build -w @evicons/react",
    "preview": "node tools/build-preview.ts",
    "typecheck": "tsc -p tools/tsconfig.json && tsc -p packages/react/tsconfig.build.json --noEmit",
    "test:smoke": "vitest run --config vitest.consumer.config.ts",
    "test:consumer-next": "node tools/test-consumer-next.ts",
    "snap": "node tools/snap-icons.ts",
    "dev:site": "npm run dev -w site",
    "build:site": "npm run build -w site",
    "test:site": "playwright test -c site/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "lucide-static": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svg-path-bbox": "^2.1.0",
    "svgo": "^4.1.0",
    "svgson": "^5.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
