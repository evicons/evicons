---
// German landing page: what EVicons is, how to install it, and every icon linked to its German page.
import {
  ChargingStation,
  MarkerCharging,
  PlugType2,
  StatusAvailable,
  StatusFaulted,
  StatusOccupied,
  StatusOutOfService,
} from '@evicons/react'
import Logo from '../../../../brand/logo.svg'
import CopyButton from '../../components/CopyButton.astro'
import { categoryLabels, iconTitles } from '../../data/icon-titles'
import Base from '../../layouts/Base.astro'
import { categoryOrder, loadIcons } from '../../lib/icons'

const icons = loadIcons()
const count = icons.length
const install = 'npm i @evicons/react'
const button = 'inline-flex items-center rounded-md px-4 py-2 text-sm font-medium no-underline'
const primary = [button, 'bg-accent text-accent-fg hover:opacity-90']
const secondary = [button, 'border border-border text-fg hover:bg-surface']
const svgAttrs = {
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.5',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
} as const
const inner = (svg: string) => svg.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').trim()

const features = [
  {
    Icon: PlugType2,
    title: 'Normgeprüfte Stecker',
    text: 'Typ 2, CCS2, CHAdeMO und Schuko als Ladebuchse in Draufsicht, die Kontakte geprüft anhand öffentlicher Zeichnungen nach IEC 62196 und DIN 49440. Kein Fantasie-Stecker.',
  },
  {
    Icon: StatusAvailable,
    title: 'Status an der Form erkennbar',
    text: 'Frei, belegt, defekt, außer Betrieb, reserviert, unbekannt und Warteschlange: Jeder Status hat eine eigene Form und funktioniert auch ohne Farbe.',
  },
  {
    Icon: MarkerCharging,
    title: 'Kartenmarker für Ladekarten',
    text: 'Pins für AC, DC und jeden Status, per CSS gefüllt. Mit Anleitung für MapLibre und Leaflet.',
  },
  {
    Icon: ChargingStation,
    title: 'Die Wörter rund ums Laden',
    text: 'Ladekarte, Roaming, Ladetarif, Ladetagebuch, Wallbox, Solarladen und kW: Icons für das, was Fahrer in Lade-Apps lesen.',
  },
]
const statusDemo = [
  { Icon: StatusAvailable, label: 'Frei', token: 'available' },
  { Icon: StatusOccupied, label: 'Belegt', token: 'occupied' },
  { Icon: StatusFaulted, label: 'Defekt', token: 'faulted' },
  { Icon: StatusOutOfService, label: 'Außer Betrieb', token: 'out-of-service' },
]
const reactCode = `import { ChargingStation, PlugType2 } from '@evicons/react'

<ChargingStation size={24} />
<PlugType2 size={20} title="Typ 2" />`
const description = `${count} kostenlose Kontur-Icons für E-Mobilität und Lade-Apps: Ladesäule, Typ 2, CCS2, Ladestatus und Kartenmarker. SVG und React, MIT-Lizenz.`
---

<Base
  title="EVicons – Icons für E-Mobilität und Ladestationen (SVG, React)"
  description={description}
  lang="de"
  alternates={{ en: '/', de: '/de' }}
>
  <section class="mx-auto max-w-6xl px-4 pb-12 pt-14 sm:px-6 sm:pb-16 sm:pt-20">
    <Logo class="h-9 w-auto text-fg sm:h-11" role="img" aria-label="EVicons" width="210" height="36" />
    <h1 class="mt-8 max-w-3xl text-4xl text-balance sm:text-5xl">Icons für E-Mobilität und Ladestationen.</h1>
    <p class="mt-4 max-w-2xl text-lg text-pretty text-muted">
      Ladesäule, Stecker, Ladestatus, Kartenmarker und die Begriffe rund ums Laden: {count}&nbsp;Kontur-Icons in einem
      Strich, als SVG und React-Komponenten. Open Source, MIT-Lizenz, kostenlos auch für kommerzielle Apps.
    </p>
    <div class="mt-8 inline-flex max-w-full items-center gap-3 rounded-lg border border-border bg-surface py-2 pl-4 pr-2">
      <code class="overflow-x-auto font-mono text-sm">{install}</code>
      <CopyButton text={install} label="Installationsbefehl kopieren" class="min-w-[6.5rem] hover:bg-bg" lang="de" />
    </div>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="#icons" class:list={primary}>Alle Icons ansehen</a>
      <a href="/docs" class:list={secondary} hreflang="en">Anleitung (Englisch)</a>
      <a href="https://github.com/evicons/evicons" class:list={secondary}>GitHub</a>
    </div>
  </section>

  <section aria-labelledby="warum" class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h2 id="warum" class="text-2xl">Gemacht für Lade-Apps im deutschen Markt</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        features.map(({ Icon, title, text }) => (
          <li class="rounded-xl border border-border p-5">
            <span class="text-link">
              <Icon size={32} />
            </span>
            <h3 class="mt-3 text-lg">{title}</h3>
            <p class="mt-2 text-muted">{text}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 max-w-3xl text-muted">
      Alle Icons sind auf Deutsch, Englisch und Französisch verschlagwortet: In der Galerie findet „Ladesäule“ die
      Ladestation und „Ladekarte“ die RFID-Karte. Die Icons ergänzen Text, sie ersetzen ihn nicht.
    </p>
  </section>

  <section aria-labelledby="einbinden" class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h2 id="einbinden" class="text-2xl">So bindest du EVicons ein</h2>
    <div class="mt-6 grid grid-cols-1 gap-8 lg:grid-cols-2">
      <div class="min-w-0">
        <h3 class="text-lg">React</h3>
        <p class="mt-2 text-muted">
          Paket installieren, Komponente importieren. Jedes Icon ist ein eigenes Modul, dein Bundle enthält nur die Icons,
          die du nutzt. Größe, Strichstärke und Farbe steuerst du per Props oder CSS (<code class="font-mono text-sm"
            >currentColor</code
          >).
        </p>
        <pre class="mt-4 overflow-x-auto rounded-lg border border-border bg-surface p-4 font-mono text-sm"><code>{reactCode}</code></pre>
      </div>
      <div class="min-w-0">
        <h3 class="text-lg">SVG, Sprite und Farbe</h3>
        <p class="mt-2 text-muted">
          Ohne React: <code class="font-mono text-sm">@evicons/svg</code> enthält jedes Icon als SVG-Datei und ein Sprite.
          Die Icons haben keine eigene Farbe. Den Status färbt deine App, zum Beispiel so:
        </p>
        <ul class="mt-4 flex flex-wrap gap-4">
          {
            statusDemo.map(({ Icon, label, token }) => (
              <li class="flex items-center gap-2 rounded-lg border border-border px-3 py-2">
                <span style={`color:var(--status-${token})`}>
                  <Icon size={24} />
                </span>
                <span class="text-sm">{label}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-sm text-muted">
          Ausführlich, mit Barrierefreiheit und Kartenmarkern für MapLibre: <a href="/docs" hreflang="en">Anleitung</a>{" "}
          (Englisch).
        </p>
      </div>
    </div>
  </section>

  <section aria-labelledby="icons" class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h2 id="icons" class="text-2xl">Alle {count} Icons</h2>
    <p class="mt-2 max-w-2xl text-muted">
      Jedes Icon hat eine eigene Seite mit Bedeutung, Norm, Code zum Kopieren und SVG-Download. Zum Suchen und Einfärben:{" "}
      <a href="/icons">Galerie</a>.
    </p>
    {
      categoryOrder.map((category) => (
        <div class="mt-10">
          <h3 id={category} class="text-lg">
            {categoryLabels[category].de}
          </h3>
          <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-6">
            {icons
              .filter((icon) => icon.category === category)
              .map((icon) => (
                <li>
                  <a
                    href={`/de/icons/${icon.name}`}
                    class="flex h-full flex-col items-center gap-3 rounded-lg border border-border px-3 py-4 text-center text-sm text-fg no-underline hover:bg-surface"
                  >
                    <span class:list={[category === 'marker' && 'marker-filled']} style={category === 'marker' ? 'color:#2563eb' : undefined}>
                      <svg width="32" height="32" {...svgAttrs} set:html={inner(icon.svg)} />
                    </span>
                    <span>{iconTitles[icon.name]!.de}</span>
                  </a>
                </li>
              ))}
          </ul>
        </div>
      ))
    }
  </section>
</Base>
