---
import {
  MarkerAvailable,
  MarkerFaulted,
  MarkerOccupied,
  PlugCcs2,
  PlugChademo,
  PlugSchuko,
  PlugType2,
  StatusAvailable,
  StatusFaulted,
  StatusOccupied,
} from '@evicons/react'
import Base from '../layouts/Base.astro'

const install = 'npm i @evicons/react'
const button = 'inline-flex items-center rounded-md px-4 py-2 text-sm font-medium no-underline'
---

<Base
  title="EVicons – Outline icons for EV charging"
  description="Connectors, charging status, map markers and the words around them — 43 icons, one stroke, MIT."
>
  <section class="mx-auto max-w-6xl px-4 pb-16 pt-16 sm:px-6 sm:pt-24">
    <h1 class="max-w-3xl text-4xl sm:text-5xl">Outline icons for EV charging.</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      Connectors, charging status, map markers and the words around them — 43 icons, one stroke, MIT.
    </p>

    <div class="mt-8 inline-flex max-w-full items-center gap-3 rounded-lg border border-border bg-surface py-2 pl-4 pr-2">
      <code class="overflow-x-auto font-mono text-sm">{install}</code>
      <button
        type="button"
        data-copy={install}
        class="rounded-md px-2 py-1 text-sm text-muted hover:bg-bg hover:text-fg"
        aria-label="Copy install command">Copy</button
      >
      <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/icons" class:list={[button, 'bg-accent text-accent-fg hover:opacity-90']}>Browse icons</a>
      <a href="/docs" class:list={[button, 'border border-border text-fg hover:bg-surface']}>Read the docs</a>
      <a href="https://github.com/evicons/evicons" class:list={[button, 'border border-border text-fg hover:bg-surface']}
        >GitHub</a
      >
    </div>
  </section>

  <section aria-labelledby="features" class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <h2 id="features" class="sr-only">Features</h2>
    <div class="grid gap-4 md:grid-cols-3">
      <article class="rounded-lg border border-border p-6">
        <div class="flex gap-3 text-accent">
          <PlugType2 size={32} /><PlugCcs2 size={32} /><PlugChademo size={32} /><PlugSchuko size={32} />
        </div>
        <h3 class="mt-4 text-lg">Standards-checked connectors</h3>
        <p class="mt-2 text-muted">Type 2, CCS2, CHAdeMO and Schuko, drawn as the vehicle inlet seen from the front.</p>
      </article>
      <article class="rounded-lg border border-border p-6">
        <div class="flex gap-3">
          <StatusAvailable size={32} className="text-status-available" />
          <StatusOccupied size={32} className="text-status-occupied" />
          <StatusFaulted size={32} className="text-status-faulted" />
        </div>
        <h3 class="mt-4 text-lg">Status by shape</h3>
        <p class="mt-2 text-muted">Seven charging states that read without colour. Your app adds the colour.</p>
      </article>
      <article class="rounded-lg border border-border p-6">
        <div class="flex gap-3 text-accent">
          <MarkerAvailable size={32} /><MarkerOccupied size={32} /><MarkerFaulted size={32} />
        </div>
        <h3 class="mt-4 text-lg">Map markers</h3>
        <p class="mt-2 text-muted">Pins for charging points, filled with CSS on any map.</p>
      </article>
    </div>
  </section>

  <section aria-labelledby="market" class="border-t border-border">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 id="market" class="text-2xl">Made for the German charging market</h2>
      <p class="mt-3 max-w-2xl text-muted">Built by the team behind ladejetzt.de and charge.tn.</p>
    </div>
  </section>
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const status = button.parentElement?.querySelector<HTMLElement>('[data-copy-status]')
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '')
        button.textContent = 'Copied'
        if (status) status.textContent = 'Copied to clipboard'
      } catch {
        button.textContent = 'Copy failed'
      }
      setTimeout(() => {
        button.textContent = 'Copy'
        if (status) status.textContent = ''
      }, 2000)
    })
  }
</script>
