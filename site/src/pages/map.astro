---
import ChargingMap from '../components/map/ChargingMap'
import Legend from '../components/map/Legend'
import { stations } from '../components/map/stations'
import Base from '../layouts/Base.astro'
---

<Base
  title="Map – EVicons"
  description="EVicons map markers on a live MapLibre map: filled pins for each charging status, with AC and DC badges."
>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-12">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
      <h1 class="text-3xl">Map</h1>
      <p
        class="rounded-full border border-border bg-surface px-3 py-1 text-sm font-medium text-fg"
        data-demo-notice
      >
        Demo data — fictional charge points
      </p>
    </div>
    <p class="mt-2 max-w-2xl text-muted" data-map-intro>
      {stations.length} charge points around Rosenheim, drawn with the{' '}
      <code class="font-mono text-[0.9em]">marker-*</code>{' '}icons: one filled pin per status, with an AC or DC badge. Zoom out and nearby pins merge into a cluster with a count. Select a pin or a station for its connectors and power.
      See <a href="/docs#markers">Map markers</a> for the code.
    </p>

    <div class="mt-8">
      <ChargingMap client:load>
        <Legend />
      </ChargingMap>
    </div>

    <p class="mt-6 max-w-2xl text-sm text-muted" data-privacy-note>
      Map tiles are loaded from <a href="https://openfreemap.org">OpenFreeMap</a> when you open this page; map data{' '}
      © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>. See the{' '}
      <a href="/privacy#kartenkacheln">privacy policy</a>.
    </p>
  </section>
</Base>

<style is:global>
  /* MapLibre popups and controls in the site theme. */
  [data-map] .maplibregl-popup-content {
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.75rem 0.875rem;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.15);
    font: inherit;
  }
  [data-map] .maplibregl-popup-anchor-bottom .maplibregl-popup-tip,
  [data-map] .maplibregl-popup-anchor-bottom-left .maplibregl-popup-tip,
  [data-map] .maplibregl-popup-anchor-bottom-right .maplibregl-popup-tip {
    border-top-color: var(--bg);
  }
  [data-map] .maplibregl-popup-anchor-top .maplibregl-popup-tip,
  [data-map] .maplibregl-popup-anchor-top-left .maplibregl-popup-tip,
  [data-map] .maplibregl-popup-anchor-top-right .maplibregl-popup-tip {
    border-bottom-color: var(--bg);
  }
  [data-map] .maplibregl-popup-anchor-left .maplibregl-popup-tip {
    border-right-color: var(--bg);
  }
  [data-map] .maplibregl-popup-anchor-right .maplibregl-popup-tip {
    border-left-color: var(--bg);
  }
  /* The attribution sits on the light tiles in both themes: keep its plain text dark. */
  [data-map] .maplibregl-ctrl-attrib {
    color: rgb(0 0 0 / 0.75);
  }
  [data-map] .maplibregl-popup-close-button {
    color: var(--muted);
    font-size: 1.25rem;
    line-height: 1;
    width: 2rem;
    height: 2rem;
    border-radius: 0 0.5rem 0 0.375rem;
  }
  [data-map] .maplibregl-popup-close-button:hover {
    background: var(--surface);
    color: var(--fg);
  }
</style>
