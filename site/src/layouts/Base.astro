---
import '../styles/global.css'
// The Latin subset of Inter, preloaded: it is used on every page, and arriving before first paint it
// does not swap in later and shift the text.
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'

interface Props {
  title: string
  description: string
  ogImage?: string
  /** Text alternative for the social image; required with a custom `ogImage`. */
  ogImageAlt?: string
  /** Error pages: no canonical/og:url, not indexed. */
  noindex?: boolean
}

const { title, description, ogImage, ogImageAlt, noindex = false } = Astro.props
// One URL form everywhere: no trailing slash (except the root).
const path = Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/+$/, '') : '/'
const canonical = new URL(path, Astro.site)
// Default social image: public/og.png (1200 × 630), rendered by scripts/render-og.mjs.
const image = new URL(ogImage ?? '/og.png', Astro.site).href
const imageAlt = ogImageAlt ?? (ogImage ? title : 'EVicons: outline icons for EV charging')
// Structured data for search engines: the project as open-source code.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'EVicons',
  description: 'Open-source outline icons for EV charging: connectors, charging status, map markers.',
  url: new URL('/', Astro.site).href,
  codeRepository: 'https://github.com/evicons/evicons',
  programmingLanguage: 'TypeScript',
  license: 'https://opensource.org/license/mit',
  publisher: { '@type': 'Organization', name: 'Landolsi Digital', url: 'https://landolsi.de' },
})
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical.href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EVicons" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical.href} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={imageAlt} />
    {
      !ogImage && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {!noindex && <script type="application/ld+json" is:inline set:html={jsonLd} />}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Set the theme before first paint: stored choice, else the system setting.
      ;(() => {
        let theme
        try {
          theme = localStorage.getItem('theme')
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        }
        document.documentElement.dataset.theme = theme
      })()
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-bg text-fg">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-accent focus:px-3 focus:py-2 focus:text-accent-fg"
      >Skip to content</a
    >
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
