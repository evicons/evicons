---
import {
  CarElectric,
  ChargingCard,
  ChargingStation,
  FastCharging,
  MarkerCharging,
  PlugCcs2,
  PlugChademo,
  PlugSchuko,
  PlugType2,
  PowerKw,
  StatusAvailable,
  StatusFaulted,
  StatusOccupied,
  StatusOutOfService,
  StatusQueue,
  StatusReserved,
  StatusUnknown,
} from '@evicons/react'
import Logo from '../../../../brand/logo.svg'
import CopyButton from '../CopyButton.astro'
import IconStrip from './IconStrip.astro'
import MapMock from './MapMock.astro'
import Base from '../../layouts/Base.astro'
import { loadIcons } from '../../lib/icons'

// The landing page in English (/) and German (/de): same layout, translated copy.
interface Props {
  lang: 'en' | 'de'
}
const { lang } = Astro.props
const de = lang === 'de'

const count = loadIcons().length
const tagline = de
  ? `Stecker, Ladestatus, Kartenmarker und die Begriffe rund ums Laden: ${count} Icons, ein Strich, MIT-Lizenz.`
  : `Connectors, charging status, map markers and the words around them — ${count} icons, one stroke, MIT.`
const s = de
  ? {
      title: 'EVicons – Icons für E-Mobilität und Ladestationen (SVG, React)',
      description: `${count} kostenlose Kontur-Icons für E-Mobilität und Lade-Apps: Ladesäule, Typ 2, CCS2, Ladestatus und Kartenmarker. SVG und React, MIT-Lizenz.`,
      h1: 'Kontur-Icons fürs E-Auto-Laden.',
      copyInstall: 'Installationsbefehl kopieren',
      browse: 'Icons ansehen',
      browseHref: '/de/icons',
      docs: 'Anleitung (Englisch)',
      strip: 'Icon-Laufband',
      stripCaption: `Alle ${count} Icons im 24-×-24-Raster mit 1,5er Strich.`,
      openGallery: 'Zur Galerie',
      pause: 'Bewegung anhalten',
      featuresTitle: 'Gezeichnet für Lade-Apps',
      featuresText:
        'Jedes Icon ist für eine Aufgabe in einer Lade-App gezeichnet und auf hellem und dunklem Grund in den Größen geprüft, für die es gemacht ist: 16, 20 und 24\u00a0px, Kartenmarker in 24, 32 und 40\u00a0px.',
      connectorsTitle: 'Normgerechte Stecker',
      connectorsText:
        'Typ 2, CCS2 und CHAdeMO als Fahrzeug-Ladebuchse, Schuko als Steckdose, jeweils anhand öffentlicher Zeichnungen der Norm geprüft.',
      connectorsLink: 'Stecker ansehen',
      connectorsHref: '/de/icons/plug-type-2',
      statusTitle: 'Status an der Form erkennbar',
      statusText:
        'Sieben Ladezustände, die auch ohne Farbe lesbar sind: Das Zeichen im Rahmen trägt die Bedeutung. Die Farbe gibt deine App dazu.',
      statusLink: 'Status-Farben in der Anleitung',
      markersTitle: 'Kartenmarker',
      markersText:
        'Pins für Ladepunkte, gefüllt mit zwei CSS-Regeln: Die Nadel bekommt deine Farbe, das Zeichen wird weiß. Bereit für MapLibre und Leaflet.',
      markersLink: 'Zur Karten-Demo',
      marketTitle: 'Gemacht für den deutschen Lademarkt',
      marketBy: 'Gebaut vom Team hinter',
      marketAnd: 'und',
      marketFor: 'für Betreiber-Apps, Ladekarten-Anbieter und die Agenturen, die sie bauen.',
      startTitle: 'Fang mit einem Icon an',
      startReact: 'React-Komponenten aus',
      startOr: 'oder SVG-Dateien und ein Sprite aus',
      installGuide: 'Installation',
    }
  : {
      title: 'EVicons – Outline icons for EV charging',
      description: tagline,
      h1: 'Outline icons for EV charging.',
      copyInstall: 'Copy install command',
      browse: 'Browse icons',
      browseHref: '/icons',
      docs: 'Read the docs',
      strip: 'Icon strip',
      stripCaption: `All ${count} icons on a 24\u00a0×\u00a024 grid with a 1.5 stroke.`,
      openGallery: 'Open the gallery',
      pause: 'Pause motion',
      featuresTitle: 'Drawn for charging apps',
      featuresText:
        'Each icon is drawn for one job in an EV charging app and checked on light and dark backgrounds at the sizes it is made for: 16, 20 and 24\u00a0px, map markers at 24, 32 and 40\u00a0px.',
      connectorsTitle: 'Standards-checked connectors',
      connectorsText:
        'Type 2, CCS2 and CHAdeMO as the vehicle inlet, Schuko as the socket, each checked against public drawings of its standard.',
      connectorsLink: 'Connectors in the gallery',
      connectorsHref: '/icons?icon=plug-type-2',
      statusTitle: 'Status by shape',
      statusText:
        'Seven charging states that read without colour: the sign in the frame carries the meaning. Your app adds the colour.',
      statusLink: 'Status colours in the docs',
      markersTitle: 'Map markers',
      markersText:
        'Pins for charge points, filled with two CSS rules: the pin takes your colour, the sign turns white. Ready for MapLibre and Leaflet.',
      markersLink: 'Open the map demo',
      marketTitle: 'Made for the German charging market',
      marketBy: 'Built by the team behind',
      marketAnd: 'and',
      marketFor: 'for operator apps, charging card providers and the agencies that build them.',
      startTitle: 'Start with one icon',
      startReact: 'React components from',
      startOr: 'or plain SVG files and a sprite from',
      installGuide: 'Install guide',
    }
// Desktop hero illustration: nine key icons, 3 × 3.
const cluster = [
  ChargingStation,
  PlugCcs2,
  PlugType2,
  StatusAvailable,
  MarkerCharging,
  CarElectric,
  PowerKw,
  ChargingCard,
  FastCharging,
]
const install = 'npm i @evicons/react'
const button = 'inline-flex items-center rounded-md px-4 py-2 text-sm font-medium no-underline'
const primary = [button, 'bg-accent text-accent-fg hover:opacity-90']
const secondary = [button, 'border border-border text-fg hover:bg-surface']

const connectors = [
  { Icon: PlugType2, label: de ? 'Typ 2' : 'Type 2' },
  { Icon: PlugCcs2, label: 'CCS2' },
  { Icon: PlugChademo, label: 'CHAdeMO' },
  { Icon: PlugSchuko, label: 'Schuko' },
]
const statusShapes = [
  StatusAvailable,
  StatusOccupied,
  StatusFaulted,
  StatusOutOfService,
  StatusReserved,
  StatusUnknown,
  StatusQueue,
]
const statusDemo = [
  { Icon: StatusAvailable, label: de ? 'Frei' : 'Available', token: 'available' },
  { Icon: StatusOccupied, label: de ? 'Belegt' : 'Occupied', token: 'occupied' },
  { Icon: StatusFaulted, label: de ? 'Defekt' : 'Faulted', token: 'faulted' },
  { Icon: StatusOutOfService, label: de ? 'Außer Betrieb' : 'Out of service', token: 'out-of-service' },
]
const market = de
  ? [
      {
        title: 'Auf Deutsch durchsuchbar',
        text: 'Jedes Icon ist auf Englisch, Deutsch und Französisch verschlagwortet: „Ladesäule“ findet die Ladestation, „Ladekarte“ die Ladekarte.',
      },
      {
        title: 'Die Wörter, die Fahrer lesen',
        text: 'AC, DC und kW sind im Icon-Strich gezeichnet; Ladekarten, Roaming, Tarife und das Ladetagebuch haben eigene Icons.',
      },
      {
        title: 'Icons neben Text',
        text: 'Die Icons unterstützen eine Beschriftung, sie ersetzen sie nicht. Der Status ist an der Form erkennbar und funktioniert auch ohne Farbe.',
      },
    ]
  : [
  {
    title: 'Searchable in German',
    text: 'Every icon is tagged in English, German and French: “Ladesäule” finds the charging station, “Ladekarte” the charging card.',
  },
  {
    title: 'The words drivers read',
    text: 'AC, DC and kW are drawn in the icon stroke; charging cards, roaming, tariffs and the charging log have their own icons.',
  },
  {
    title: 'Icons next to text',
    text: 'The icons support a label, they do not replace it. Status reads by shape, so it still works without colour.',
  },
]
---

<Base title={s.title} description={s.description} lang={lang} alternates={{ en: '/', de: '/de' }}>
  <div class="home">
    <section
      class="mx-auto max-w-6xl px-4 pb-12 pt-14 sm:px-6 sm:pb-16 sm:pt-20 lg:grid lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-16"
    >
      <div>
        <Logo class="h-9 w-auto text-fg sm:h-11" role="img" aria-label="EVicons" width="210" height="36" />
        <h1 class="mt-8 max-w-3xl text-4xl text-balance sm:text-5xl">{s.h1}</h1>
        <p class="mt-4 max-w-2xl text-lg text-pretty text-muted" data-tagline>
          {
            de ? (
              <>
                Stecker, Ladestatus, Kartenmarker und die Begriffe rund ums Laden: <span data-icon-count>{count}</span
                >&nbsp;Icons, ein Strich, MIT-Lizenz.
              </>
            ) : (
              <>
                Connectors, charging status, map markers and the words around them — <span data-icon-count>{count}</span
                >&nbsp;icons, one stroke, MIT.
              </>
            )
          }
        </p>

        <div
          class="mt-8 inline-flex max-w-full items-center gap-3 rounded-lg border border-border bg-surface py-2 pl-4 pr-2"
        >
          <code class="overflow-x-auto font-mono text-sm">{install}</code>
          <CopyButton text={install} label={s.copyInstall} class="min-w-[6.5rem] hover:bg-bg" lang={lang} />
        </div>

        <div class="mt-6 flex flex-wrap gap-3">
          <a href={s.browseHref} class:list={primary}>{s.browse}</a>
          <a href="/docs" class:list={secondary} hreflang={de ? 'en' : undefined}>{s.docs}</a>
          <a href="https://github.com/evicons/evicons" class:list={secondary}>GitHub</a>
        </div>
      </div>

      <div class="hero-cluster hidden lg:grid" aria-hidden="true" data-hero-cluster>
        {
          cluster.map((Icon) => (
            <span class="hero-tile">
              <Icon size={48} />
            </span>
          ))
        }
      </div>
    </section>

    <section aria-label={s.strip} class="mx-auto max-w-6xl px-4 sm:px-6">
      <IconStrip />
      <div class="mt-3 flex items-start justify-between gap-4">
        <p class="text-sm text-muted" data-strip-caption>
          {s.stripCaption}{' '}
          <a href={s.browseHref} class="whitespace-nowrap">{s.openGallery}</a>
        </p>
        <button type="button" class="strip-pause" aria-pressed="false" data-strip-pause>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path class="strip-pause-glyph" d="M9 5v14M15 5v14" />
            <path class="strip-play-glyph" d="M8 5.5v13l10-6.5Z" />
          </svg>
          {s.pause}
        </button>
      </div>
    </section>

    <section aria-labelledby="features" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <h2 id="features" class="text-2xl text-balance sm:text-3xl">{s.featuresTitle}</h2>
      <p class="mt-3 max-w-3xl text-pretty text-muted">
        {s.featuresText}
      </p>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        <article class="feature">
          <div class="feature-visual grid grid-cols-4 items-center px-2 text-fg">
            {
              connectors.map(({ Icon, label }) => (
                <figure class="flex flex-col items-center gap-2">
                  <Icon size={40} />
                  <figcaption class="text-xs font-medium text-muted">{label}</figcaption>
                </figure>
              ))
            }
          </div>
          <h3 class="feature-title">{s.connectorsTitle}</h3>
          <p class="feature-text">{s.connectorsText}</p>
          <a href={s.connectorsHref} class="feature-link">{s.connectorsLink}</a>
        </article>

        <article class="feature">
          <div class="feature-visual flex flex-col justify-center gap-5 px-5" data-status-demo>
            <div class="flex justify-between text-fg">
              {statusShapes.map((Icon) => <Icon size={26} />)}
            </div>
            <ul class="grid grid-cols-2 gap-x-3 gap-y-2 text-sm">
              {
                statusDemo.map(({ Icon, label, token }) => (
                  <li class="flex items-center gap-2 whitespace-nowrap">
                    <Icon size={20} className="shrink-0" style={{ color: `var(--status-${token})` }} />
                    {label}
                  </li>
                ))
              }
            </ul>
          </div>
          <h3 class="feature-title">{s.statusTitle}</h3>
          <p class="feature-text">{s.statusText}</p>
          <a href="/docs#status" class="feature-link">{s.statusLink}</a>
        </article>

        <article class="feature">
          <div class="feature-visual overflow-hidden">
            <MapMock />
          </div>
          <h3 class="feature-title">{s.markersTitle}</h3>
          <p class="feature-text">{s.markersText}</p>
          <a href="/map" class="feature-link">{s.markersLink}</a>
        </article>
      </div>
    </section>

    <section aria-labelledby="market" class="border-y border-border bg-surface">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
        <div>
          <h2 id="market" class="text-2xl text-balance sm:text-3xl">{s.marketTitle}</h2>
          <p class="mt-4 max-w-2xl text-pretty text-muted">
            {s.marketBy} <a href="https://ladejetzt.de">ladejetzt.de</a> {s.marketAnd}{' '}
            <a href="https://charge.tn">charge.tn</a>, {s.marketFor}
          </p>
        </div>
        <ul class="mt-10 grid gap-8 lg:grid-cols-3 lg:gap-10">
          {
            market.map(({ title, text }) => (
              <li class="max-w-xl">
                <h3 class="text-lg">{title}</h3>
                <p class="mt-2 text-pretty text-muted">{text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section aria-labelledby="start" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
        <div>
          <h2 id="start" class="text-2xl sm:text-3xl">{s.startTitle}</h2>
          <p class="mt-3 max-w-xl text-pretty text-muted">
            {s.startReact} <code class="font-mono text-[0.9em]">@evicons/react</code>, {s.startOr}{' '}
            <code class="font-mono text-[0.9em]">@evicons/svg</code>.
          </p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-3">
          <a href={s.browseHref} class:list={primary}>{s.browse}</a>
          <a href="/docs#install" class:list={secondary} hreflang={de ? 'en' : undefined}>{s.installGuide}</a>
          <a href="https://www.npmjs.com/package/@evicons/react" class:list={secondary}>npm</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .hero-cluster {
    grid-template-columns: repeat(3, 6rem);
    gap: 0.75rem;
    color: #2563eb;
  }
  .hero-tile {
    display: flex;
    aspect-ratio: 1;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
  }
  .strip-pause {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.375rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    padding: 0.125rem 0.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .strip-pause:hover {
    color: var(--fg);
  }
  .strip-pause[aria-pressed='true'] {
    border-color: var(--fg);
    color: var(--fg);
  }
  .strip-play-glyph,
  .strip-pause[aria-pressed='true'] .strip-pause-glyph {
    display: none;
  }
  .strip-pause[aria-pressed='true'] .strip-play-glyph {
    display: inline;
  }
  /* Nothing moves with reduced motion: no control needed. */
  @media (prefers-reduced-motion: reduce) {
    .strip-pause {
      display: none;
    }
  }
  .feature {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 0.75rem 0.75rem 1.5rem;
  }
  .feature-visual {
    height: 11rem;
    border-radius: 0.5rem;
    background: var(--surface);
  }
  .feature-title {
    margin-top: 1.25rem;
    padding-inline: 0.75rem;
    font-size: 1.125rem;
  }
  .feature-text {
    margin-top: 0.5rem;
    padding-inline: 0.75rem;
    color: var(--muted);
    text-wrap: pretty;
  }
  .feature-link {
    margin-top: auto;
    padding-top: 1rem;
    padding-inline: 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }
  .feature-link::after {
    content: ' →' / '';
  }
  .feature-link:hover {
    text-decoration: underline;
  }
</style>

<script>
  // Pause/play for the icon strip (WCAG 2.2.2); hover also pauses it.
  const button = document.querySelector<HTMLButtonElement>('[data-strip-pause]')
  const strip = document.querySelector<HTMLElement>('[data-icon-strip]')
  button?.addEventListener('click', () => {
    const paused = button.getAttribute('aria-pressed') !== 'true'
    button.setAttribute('aria-pressed', String(paused))
    strip?.toggleAttribute('data-paused', paused)
  })
</script>
