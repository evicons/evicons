---
// A copy button with its own live region. Without `text` it copies the code block it sits in ([data-snippet]).
interface Props {
  /** Text to copy; omit inside a code block. */
  text?: string
  /** Accessible name, for example "Copy install command". */
  label: string
  class?: string
  /** Language of the visible button text. */
  lang?: 'en' | 'de'
  /** Statistics event name for a click (data-track, see Analytics.astro), for example "copy_svg". */
  track?: string
}

const { text, label, class: className, lang = 'en', track } = Astro.props
const strings = {
  en: { idle: 'Copy', copied: 'Copied', copiedMessage: 'Copied to clipboard', failed: 'Copy failed' },
  de: { idle: 'Kopieren', copied: 'Kopiert', copiedMessage: 'In die Zwischenablage kopiert', failed: 'Kopieren fehlgeschlagen' },
}[lang]
---

<button
  type="button"
  data-copy-button
  data-track={track}
  data-copy={text}
  data-copied={strings.copied}
  data-copied-message={strings.copiedMessage}
  data-failed={strings.failed}
  class:list={['rounded-md px-2 py-1 text-center text-sm text-muted hover:text-fg', className]}
  aria-label={label}>{strings.idle}</button
>
<span class="sr-only" role="status" aria-live="polite" data-copy-status></span>

<script>
  import { wireCopyButtons } from '../lib/copy'

  wireCopyButtons()
</script>
