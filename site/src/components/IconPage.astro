---
// One icon on its own page: /icons/<name> (English) and /de/icons/<name> (German). Static HTML only, so search
// engines see the name, meaning, standard and code; the raw SVG is linked as an image for image search.
import { Code } from 'astro:components'
import CopyButton from './CopyButton.astro'
import { categoryLabels, iconTitles } from '../data/icon-titles'
import Base from '../layouts/Base.astro'
import type { IconDetails, IconEntry } from '../lib/icons'

interface Props {
  icon: IconEntry
  details: IconDetails
  /** Same category, gallery order (includes `icon`). */
  siblings: IconEntry[]
  lang: 'en' | 'de'
}

const { icon, details, siblings, lang } = Astro.props
const de = lang === 'de'
const title = iconTitles[icon.name]![lang]
const meaning = details.meaning[lang]
const category = categoryLabels[icon.category][lang]
const marker = icon.category === 'marker'
const site = Astro.site!
const pagePath = (name: string, l: 'en' | 'de' = lang) => (l === 'de' ? `/de/icons/${name}` : `/icons/${name}`)
const svgUrl = new URL(`/svg/${icon.name}.svg`, site).href

const t = de
  ? {
      heading: `${title} Icon`,
      docTitle: `${title} Icon – SVG und React | EVicons`,
      description: `Kostenloses ${title}-Icon für Lade-Apps und E-Mobilität: ${meaning}. Kontur-SVG und React-Komponente, MIT-Lizenz.`,
      home: 'Icons',
      homeHref: '/de/icons',
      categoryHref: `/de/icons#${icon.category}`,
      sizes: 'Größen',
      onLight: 'Auf hellem Grund',
      onDark: 'Auf dunklem Grund',
      facts: 'Details',
      component: 'React-Komponente',
      file: 'SVG-Datei',
      categoryLabel: 'Kategorie',
      since: 'Seit Version',
      standard: 'Norm',
      tags: 'Suchbegriffe',
      aliases: 'Frühere Namen',
      download: 'SVG herunterladen',
      gallery: 'In der Galerie öffnen',
      source: 'Quelle auf GitHub',
      use: 'Verwenden',
      install: 'Installieren',
      react: 'React',
      svg: 'SVG',
      sprite: 'Sprite',
      spriteComment: 'sprite.svg aus @evicons/svg in den public-Ordner der App kopieren',
      a11y: marker
        ? 'Kartenmarker: Der erste Pfad ist die Nadel. Fülle ihn per CSS, das Symbol darin wird weiß (siehe Doku „Map markers“).'
        : 'Icons ergänzen Text, sie ersetzen ihn nicht. Ohne sichtbare Beschriftung braucht das Icon einen title oder ein aria-label.',
      docs: 'Anleitung (Englisch)',
      more: `Weitere Icons: ${category}`,
      all: 'Alle Icons',
      licence: 'MIT-Lizenz, frei auch für kommerzielle Apps. Ohne Namensnennung im UI, die Lizenzdatei gehört in den Code.',
      copyLabel: (what: string) => `${what}-Code kopieren`,
      alt: `${title}: EVicons-Kontur-Icon`,
    }
  : {
      heading: `${title} icon`,
      docTitle: `${title} icon – SVG and React | EVicons`,
      description: `Free ${title.toLowerCase()} icon for EV charging apps: ${meaning}. Outline SVG and React component, MIT licensed.`,
      home: 'Icons',
      homeHref: '/icons',
      categoryHref: '/icons',
      sizes: 'Sizes',
      onLight: 'On a light background',
      onDark: 'On a dark background',
      facts: 'Details',
      component: 'React component',
      file: 'SVG file',
      categoryLabel: 'Category',
      since: 'Since version',
      standard: 'Standard',
      tags: 'Search terms',
      aliases: 'Former names',
      download: 'Download SVG',
      gallery: 'Open in the gallery',
      source: 'Source on GitHub',
      use: 'Use it',
      install: 'Install',
      react: 'React',
      svg: 'SVG',
      sprite: 'Sprite',
      spriteComment: "Copy sprite.svg from @evicons/svg to your app's public folder",
      a11y: marker
        ? 'Map marker: the first path is the pin. Fill it with CSS and the sign inside turns white (see the map markers docs).'
        : 'Icons supplement text, they do not replace it. Without a visible label, give the icon a title or an aria-label.',
      docs: 'Read the docs',
      more: `More ${category.toLowerCase()}`,
      all: 'All icons',
      licence: 'MIT licence: free for commercial apps too. No credit needed in the UI; keep the licence file in your code.',
      copyLabel: (what: string) => `Copy ${what} code`,
      alt: `${title}: EVicons outline icon`,
    }

// Shorter description when the meaning is long (search results cut at about 160 characters).
const description =
  t.description.length <= 170
    ? t.description
    : de
      ? `Kostenloses ${title}-Icon für Lade-Apps und E-Mobilität. Kontur-SVG und React-Komponente, MIT-Lizenz.`
      : `Free ${title.toLowerCase()} icon for EV charging apps. Outline SVG and React component, MIT licensed.`

const inner = icon.svg.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').trim()
const svgAttrs = {
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.5',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
} as const

const install = 'npm i @evicons/react'
const reactCode = `import { ${icon.pascal} } from '@evicons/react'\n\n<${icon.pascal} size={24} title="${title}" />`
const spriteCode = `<!-- ${t.spriteComment} -->\n<svg width="24" height="24" aria-hidden="true"><use href="/sprite.svg#evicon-${icon.name}" /></svg>`
const themes = { light: 'github-light-default', dark: 'github-dark-default' } as const
// Same comment colour fix as the Markdown code blocks (astro.config.mjs): GitHub's light comment grey fails AA.
const transformers = [
  {
    name: 'evicons:comment-contrast',
    span(node: { properties: Record<string, unknown> }) {
      const style = node.properties.style
      if (typeof style === 'string') node.properties.style = style.replace('color:#6E7781;', 'color:#59636E;')
    },
  },
]

const index = siblings.findIndex((s) => s.name === icon.name)
const others = siblings.filter((s) => s.name !== icon.name)

const jsonLd = [
  {
    '@type': 'ImageObject',
    name: t.heading,
    description: meaning,
    contentUrl: svgUrl,
    encodingFormat: 'image/svg+xml',
    width: 24,
    height: 24,
    license: 'https://opensource.org/license/mit',
    acquireLicensePage: new URL('/docs#install', site).href,
    creditText: 'EVicons',
    copyrightNotice: '© 2026 Landolsi Digital, MIT licence',
    creator: { '@type': 'Organization', name: 'Landolsi Digital', url: 'https://landolsi.de' },
    keywords: [...icon.tags.en, ...icon.tags.de].join(', '),
    inLanguage: lang,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.home, item: new URL(t.homeHref, site).href },
      { '@type': 'ListItem', position: 2, name: t.heading, item: new URL(pagePath(icon.name), site).href },
    ],
  },
]

const snippetClass = 'snippet not-prose mt-3'
const githubSource = `https://github.com/evicons/evicons/blob/main/icons/${icon.name}.svg`
---

<Base
  title={t.docTitle}
  description={description}
  lang={lang}
  alternates={{ en: pagePath(icon.name, 'en'), de: pagePath(icon.name, 'de') }}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-12" data-icon-page={icon.name}>
    <nav aria-label={de ? 'Brotkrumen' : 'Breadcrumb'} class="text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-x-2">
        <li><a href={t.homeHref} class="text-muted hover:text-fg">{t.home}</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={t.categoryHref} class="text-muted hover:text-fg">{category}</a></li>
        <li aria-hidden="true">/</li>
        <li><span aria-current="page" class="font-mono">{icon.name}</span></li>
      </ol>
    </nav>

    <div class="mt-6 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
      <div class="min-w-0">
        <h1 class="text-3xl text-balance sm:text-4xl">{t.heading}</h1>
        <p class="mt-3 max-w-xl text-lg text-pretty text-muted">{meaning}</p>

        <div class="mt-8 grid grid-cols-2 gap-3">
          <figure class="m-0 rounded-xl border border-zinc-200 bg-white text-zinc-900">
            <div class:list={['flex h-40 items-center justify-center', marker && 'marker-filled']} style={marker ? 'color:#2563eb' : undefined}>
              {
                marker ? (
                  <svg width="96" height="96" {...svgAttrs} set:html={inner} />
                ) : (
                  <img src={`/svg/${icon.name}.svg`} width="96" height="96" alt={t.alt} loading="eager" />
                )
              }
            </div>
            <figcaption class="border-t border-zinc-200 px-3 py-2 text-xs text-zinc-600">{t.onLight}</figcaption>
          </figure>
          <figure class="m-0 rounded-xl border border-zinc-800 bg-zinc-900 text-zinc-100">
            <div class:list={['flex h-40 items-center justify-center', marker && 'marker-filled']} style={marker ? 'color:#60a5fa' : undefined}>
              <svg width="96" height="96" {...svgAttrs} set:html={inner} />
            </div>
            <figcaption class="border-t border-zinc-800 px-3 py-2 text-xs text-zinc-400">{t.onDark}</figcaption>
          </figure>
        </div>

        <h2 class="mt-8 text-sm font-medium text-muted">{t.sizes}</h2>
        <ul class="mt-3 flex flex-wrap items-end gap-6" aria-label={t.sizes}>
          {
            [16, 20, 24, 32, 48].map((px) => (
              <li class="flex flex-col items-center gap-2">
                <span class:list={[marker && 'marker-filled']} style={marker ? 'color:#2563eb' : undefined}>
                  <svg width={px} height={px} {...svgAttrs} set:html={inner} />
                </span>
                <span class="font-mono text-xs text-muted">{px}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={`/svg/${icon.name}.svg`}
            download={`${icon.name}.svg`}
            data-track="download_svg"
            class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-fg no-underline hover:opacity-90"
            >{t.download}</a
          >
          <a
            href={`/icons?icon=${icon.name}`}
            class="rounded-md border border-border px-4 py-2 text-sm font-medium text-fg no-underline hover:bg-surface"
            >{t.gallery}</a
          >
          <a
            href={githubSource}
            class="rounded-md border border-border px-4 py-2 text-sm font-medium text-fg no-underline hover:bg-surface"
            >{t.source}</a
          >
        </div>
      </div>

      <div class="min-w-0">
        <h2 class="text-xl">{t.use}</h2>
        <h3 class="mt-5 text-sm font-medium text-muted">{t.install}</h3>
        <div class={snippetClass} data-snippet>
          <div class="snippet-head">
            <span class="snippet-lang">Shell</span>
            <CopyButton label={t.copyLabel('Shell')} class="min-w-[6.5rem] hover:bg-bg" lang={lang} track="copy_install" />
          </div>
          <Code code={install} lang="sh" themes={themes} transformers={transformers} />
        </div>
        <h3 class="mt-5 text-sm font-medium text-muted">{t.react}</h3>
        <div class={snippetClass} data-snippet>
          <div class="snippet-head">
            <span class="snippet-lang">TSX</span>
            <CopyButton label={t.copyLabel('React')} class="min-w-[6.5rem] hover:bg-bg" lang={lang} track="copy_react" />
          </div>
          <Code code={reactCode} lang="tsx" themes={themes} transformers={transformers} />
        </div>
        <h3 class="mt-5 text-sm font-medium text-muted">{t.svg}</h3>
        <div class={snippetClass} data-snippet>
          <div class="snippet-head">
            <span class="snippet-lang">SVG</span>
            <CopyButton label={t.copyLabel('SVG')} class="min-w-[6.5rem] hover:bg-bg" lang={lang} track="copy_svg" />
          </div>
          <Code code={icon.svg} lang="html" themes={themes} transformers={transformers} />
        </div>
        <h3 class="mt-5 text-sm font-medium text-muted">{t.sprite}</h3>
        <div class={snippetClass} data-snippet>
          <div class="snippet-head">
            <span class="snippet-lang">HTML</span>
            <CopyButton label={t.copyLabel('Sprite')} class="min-w-[6.5rem] hover:bg-bg" lang={lang} track="copy_sprite" />
          </div>
          <Code code={spriteCode} lang="html" themes={themes} transformers={transformers} />
        </div>
        <p class="mt-5 text-sm text-muted">
          {t.a11y} <a href={marker ? '/docs#markers' : '/docs#accessibility'}>{t.docs}</a>
        </p>

        <h2 class="mt-10 text-xl">{t.facts}</h2>
        <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-[10rem_1fr]">
          <dt class="font-medium">{t.component}</dt>
          <dd class="font-mono">{icon.pascal}</dd>
          <dt class="font-medium">{t.file}</dt>
          <dd class="font-mono">{icon.name}.svg</dd>
          <dt class="font-medium">{t.categoryLabel}</dt>
          <dd>{category}</dd>
          <dt class="font-medium">{t.since}</dt>
          <dd class="font-mono">{details.since}</dd>
          {
            icon.standard && (
              <>
                <dt class="font-medium">{t.standard}</dt>
                <dd>{icon.standard.norm}</dd>
              </>
            )
          }
          <dt class="font-medium">{t.tags}</dt>
          <dd class="text-muted">{[...new Set(de ? [...icon.tags.de, ...icon.tags.en] : [...icon.tags.en, ...icon.tags.de])].join(', ')}</dd>
          {
            details.aliases.length > 0 && (
              <>
                <dt class="font-medium">{t.aliases}</dt>
                <dd class="font-mono">{details.aliases.join(', ')}</dd>
              </>
            )
          }
        </dl>
        <p class="mt-4 text-sm text-muted">{t.licence}</p>
      </div>
    </div>

    {
      others.length > 0 && (
        <section aria-labelledby="more" class="mt-14">
          <h2 id="more" class="text-xl">{t.more}</h2>
          <ul class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-6">
            {others.map((other) => {
              const otherInner = other.svg.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').trim()
              return (
                <li>
                  <a
                    href={pagePath(other.name)}
                    class="flex h-full flex-col items-center gap-3 rounded-lg border border-border px-3 py-4 text-center text-sm text-fg no-underline hover:bg-surface"
                  >
                    <span class:list={[other.category === 'marker' && 'marker-filled']} style={other.category === 'marker' ? 'color:#2563eb' : undefined}>
                      <svg width="32" height="32" {...svgAttrs} set:html={otherInner} />
                    </span>
                    <span>{iconTitles[other.name]![lang]}</span>
                  </a>
                </li>
              )
            })}
          </ul>
        </section>
      )
    }

    <nav aria-label={de ? 'Weitere Icons' : 'More icons'} class="mt-10 flex flex-wrap justify-between gap-4 text-sm">
      {
        index > 0 ? (
          <a href={pagePath(siblings[index - 1]!.name)} rel="prev">← {iconTitles[siblings[index - 1]!.name]![lang]}</a>
        ) : (
          <span />
        )
      }
      <a href={de ? '/de/icons' : '/icons'}>{t.all}</a>
      {
        index < siblings.length - 1 ? (
          <a href={pagePath(siblings[index + 1]!.name)} rel="next">{iconTitles[siblings[index + 1]!.name]![lang]} →</a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</Base>
