---
import Logo from '../../../brand/logo.svg'
import ThemeToggle from './ThemeToggle'

const nav = [
  { href: '/icons', label: 'Icons' },
  { href: '/docs', label: 'Docs' },
  { href: '/map', label: 'Map' },
  { href: '/brand', label: 'Brand' },
]
const path = Astro.url.pathname.replace(/\/$/, '')
---

<header class="border-b border-border">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3 sm:px-6">
    <!-- min-h-8 on the nav: the theme toggle (32 px) sets the row height before it hydrates, so the row never grows. -->
    <a href="/" class="flex items-center py-1 text-fg no-underline" aria-label="EVicons">
      <Logo width={140} height={24} class="h-6 w-auto shrink-0" aria-hidden="true" />
    </a>
    <nav aria-label="Main" class="flex min-h-8 flex-wrap items-center gap-x-5 gap-y-1 text-sm">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={['no-underline hover:text-fg', path === item.href ? 'font-medium text-fg' : 'text-muted']}
            aria-current={path === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a href="https://github.com/evicons/evicons" class="text-muted no-underline hover:text-fg">GitHub</a>
      <ThemeToggle client:load />
    </nav>
  </div>
</header>
