---
// Legal pages (legal notice, privacy policy), in English like the rest of the site.
import Base from '../layouts/Base.astro'

interface Props {
  title: string
  heading: string
  description: string
}

const { title, heading, description } = Astro.props
---

<Base title={title} description={description}>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-16">
    <article class="doc legal max-w-3xl">
      <h1>{heading}</h1>
      <slot />
    </article>
  </div>
</Base>
