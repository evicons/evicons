---
// Legal pages (Impressum, Datenschutzerklärung): German text under German law, with an English one-liner.
import Base from '../layouts/Base.astro'

interface Props {
  title: string
  heading: string
  /** English one-liner under the German heading. */
  summary: string
  description: string
}

const { title, heading, summary, description } = Astro.props
---

<Base title={title} description={description}>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-16">
    <article class="doc legal max-w-3xl" lang="de">
      <h1>{heading}</h1>
      <p class="lead" lang="en">{summary}</p>
      <slot />
    </article>
  </div>
</Base>
